{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "verde-kiwi",  "color": "#2F5D3F", "name": "Verde Kiwi" },
        { "slug": "lima-kiwi",   "color": "#C3DE4E", "name": "Lima Kiwi" },
        { "slug": "guayaba",     "color": "#C0523A", "name": "Guayaba" },
        { "slug": "indigo",      "color": "#3F4E7A", "name": "Índigo" },
        { "slug": "crema",       "color": "#F6F3EA", "name": "Crema" },
        { "slug": "crema-alta",  "color": "#FFFDF7", "name": "Crema alta" },
        { "slug": "bruma",       "color": "#CFCBBD", "name": "Bruma" },
        { "slug": "divisor",     "color": "#E3DFD2", "name": "Divisor" },
        { "slug": "grafito",     "color": "#1C231E", "name": "Grafito" },
        { "slug": "texto-medio", "color": "#3E4740", "name": "Texto medio" },
        { "slug": "texto-muted", "color": "#5C665D", "name": "Texto muted" },
        { "slug": "texto-debil", "color": "#8A9189", "name": "Texto débil" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "archivo",
          "name": "Archivo",
          "fontFamily": "Archivo, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Archivo",
              "fontWeight": "500 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/archivo-variable.woff2"]
            }
          ]
        },
        {
          "slug": "karla",
          "name": "Karla",
          "fontFamily": "Karla, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Karla",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/karla-variable.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "legal",    "size": "12px", "name": "Legal" },
        { "slug": "etiqueta", "size": "11px", "name": "Etiqueta" },
        { "slug": "cuerpo",   "size": "16px", "name": "Cuerpo" },
        { "slug": "h3",       "size": "18px", "name": "H3" },
        { "slug": "precio",   "size": "22px", "name": "Precio" },
        { "slug": "h2",       "size": "28px", "name": "H2" },
        { "slug": "h1",       "size": "44px", "name": "H1" }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "units": ["px", "rem", "%"],
      "spacingSizes": [
        { "slug": "10", "size": "4px",  "name": "4" },
        { "slug": "20", "size": "8px",  "name": "8" },
        { "slug": "30", "size": "12px", "name": "12" },
        { "slug": "40", "size": "16px", "name": "16" },
        { "slug": "50", "size": "20px", "name": "20" },
        { "slug": "60", "size": "26px", "name": "26" },
        { "slug": "70", "size": "32px", "name": "32" },
        { "slug": "80", "size": "40px", "name": "40" },
        { "slug": "90", "size": "52px", "name": "52" }
      ]
    },
    "layout": {
      "contentSize": "1360px",
      "wideSize": "1440px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--crema)",
      "text": "var(--wp--preset--color--grafito)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--karla)",
      "fontSize": "var(--wp--preset--font-size--cuerpo)",
      "lineHeight": "1.55"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontWeight": "700",
          "letterSpacing": "-0.03em"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--verde-kiwi)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--guayaba)" } }
      },
      "button": {
        "border": { "radius": "2px" },
        "color": {
          "background": "var(--wp--preset--color--verde-kiwi)",
          "text": "var(--wp--preset--color--crema)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontWeight": "700",
          "fontSize": "17px"
        },
        "spacing": {
          "padding": { "top": "16px", "bottom": "16px", "left": "26px", "right": "26px" }
        }
      }
    }
  }
}
