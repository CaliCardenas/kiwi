{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": {
      "radiusSizes": [
        { "slug": "base",  "size": "2px", "name": "Base" },
        { "slug": "badge", "size": "8px", "name": "Badge del carrito" }
      ]
    },
    "custom": {
      "borde": { "fino": "1px", "medio": "1.5px" },
      "interlinea": { "legal": "17px" },
      "foco": { "ancho": "2px", "separacion": "2px" },
      "transicion": { "duracion": "200ms", "curva": "ease-out" }
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "verde-kiwi",  "color": "#2F5D3F", "name": "Verde Kiwi" },
        { "slug": "lima-kiwi",   "color": "#C3DE4E", "name": "Lima Kiwi" },
        { "slug": "guayaba",     "color": "#C0523A", "name": "Guayaba" },
        { "slug": "indigo",      "color": "#3F4E7A", "name": "Índigo" },
        { "slug": "crema",       "color": "#F6F3EA", "name": "Crema" },
        { "slug": "crema-alta",  "color": "#FFFDF7", "name": "Crema alta" },
        { "slug": "bruma",       "color": "#CFCBBD", "name": "Bruma" },
        { "slug": "divisor",     "color": "#E3DFD2", "name": "Divisor" },
        { "slug": "aviso",       "color": "#F1EEE2", "name": "Aviso" },
        { "slug": "borde-oscuro", "color": "#4A524B", "name": "Borde oscuro" },
        { "slug": "grafito",     "color": "#1C231E", "name": "Grafito" },
        { "slug": "texto-medio", "color": "#3E4740", "name": "Texto medio" },
        { "slug": "texto-muted", "color": "#5C665D", "name": "Texto muted" },
        { "slug": "texto-debil", "color": "#8A9189", "name": "Texto débil" }
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "favorito", "shadow": "0 1px 3px rgba(28,35,30,.16)", "name": "Favorito flotante" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "archivo",
          "name": "Archivo",
          "fontFamily": "Archivo, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Archivo",
              "fontWeight": "500 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/archivo-variable.woff2"]
            }
          ]
        },
        {
          "slug": "karla",
          "name": "Karla",
          "fontFamily": "Karla, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Karla",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/karla-variable.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "10",       "size": "10px", "name": "10" },
        { "slug": "etiqueta", "size": "11px", "name": "Etiqueta" },
        { "slug": "legal",    "size": "12px", "name": "Legal" },
        { "slug": "13",       "size": "13px", "name": "13" },
        { "slug": "14",       "size": "14px", "name": "14" },
        { "slug": "15",       "size": "15px", "name": "15" },
        { "slug": "cuerpo",   "size": "16px", "name": "Cuerpo" },
        { "slug": "17",       "size": "17px", "name": "17" },
        { "slug": "h3",       "size": "18px", "name": "H3" },
        { "slug": "19",       "size": "19px", "name": "19" },
        { "slug": "21",       "size": "21px", "name": "21" },
        { "slug": "precio",   "size": "22px", "name": "Precio" },
        { "slug": "24",       "size": "24px", "name": "24" },
        { "slug": "26",       "size": "26px", "name": "26" },
        { "slug": "h2",       "size": "28px", "name": "H2" },
        { "slug": "h1",       "size": "44px", "name": "H1" },
        { "slug": "52",       "size": "52px", "name": "52" },
        { "slug": "60",       "size": "60px", "name": "60" }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "units": ["px", "rem", "%"],
      "spacingSizes": [
        { "slug": "10", "size": "4px",  "name": "4" },
        { "slug": "20", "size": "8px",  "name": "8" },
        { "slug": "30", "size": "12px", "name": "12" },
        { "slug": "40", "size": "16px", "name": "16" },
        { "slug": "50", "size": "20px", "name": "20" },
        { "slug": "60", "size": "24px", "name": "24" },
        { "slug": "70", "size": "32px", "name": "32" },
        { "slug": "80", "size": "40px", "name": "40" },
        { "slug": "85", "size": "48px", "name": "48" },
        { "slug": "90", "size": "52px", "name": "52" }
      ]
    },
    "dimensions": {
      "dimensionSizes": [
        { "slug": "punto",           "size": "6px",   "name": "Punto de la barra" },
        { "slug": "badge",           "size": "16px",  "name": "Badge del carrito" },
        { "slug": "icono",           "size": "22px",  "name": "Icono del header" },
        { "slug": "logo",            "size": "36px",  "name": "Logo del header" },
        { "slug": "buscador-alto",   "size": "42px",  "name": "Buscador · alto" },
        { "slug": "objetivo-tactil", "size": "44px",  "name": "Objetivo táctil mínimo" },
        { "slug": "punto-galeria",   "size": "7px",   "name": "Punto de la galería" },
        { "slug": "check",           "size": "15px",  "name": "Casilla de filtro" },
        { "slug": "riel",            "size": "4px",   "name": "Riel del slider de precio" },
        { "slug": "tirador",         "size": "14px",  "name": "Tirador del slider de precio" },
        { "slug": "icono-13",        "size": "13px",  "name": "Icono 13 (chevron del orden)" },
        { "slug": "icono-17",        "size": "17px",  "name": "Icono 17 (guía de tallas)" },
        { "slug": "icono-18",        "size": "18px",  "name": "Icono 18 (avisos y fila de confianza)" },
        { "slug": "icono-20",        "size": "20px",  "name": "Icono 20 (botones y sellos)" },
        { "slug": "orden-alto",      "size": "38px",  "name": "Selector de orden · alto" },
        { "slug": "boton-secundario","size": "48px",  "name": "Botón secundario · alto" },
        { "slug": "talla",           "size": "48px",  "name": "Opción de talla · alto" },
        { "slug": "boton-primario",  "size": "56px",  "name": "Botón primario · alto" },
        { "slug": "filtros-ancho",   "size": "236px", "name": "Sidebar de filtros · ancho" },
        { "slug": "galeria-alto",    "size": "400px", "name": "Galería de la ficha · alto" },
        { "slug": "ficha-ancho",     "size": "520px", "name": "Ficha en escritorio · ancho" },
        { "slug": "buscador-ancho",  "size": "296px", "name": "Buscador · ancho" }
      ]
    },
    "layout": {
      "contentSize": "1360px",
      "wideSize": "1440px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--crema)",
      "text": "var(--wp--preset--color--grafito)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--karla)",
      "fontSize": "var(--wp--preset--font-size--cuerpo)",
      "lineHeight": "1.55"
    },
    "blocks": {
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "var(--wp--preset--color--verde-kiwi)",
              "style": "solid",
              "width": "var(--wp--custom--borde--medio)"
            },
            "color": {
              "background": "transparent",
              "text": "var(--wp--preset--color--verde-kiwi)"
            },
            "typography": {
              "fontWeight": "600",
              "fontSize": "var(--wp--preset--font-size--15)"
            }
          },
          "sello": {
            "color": {
              "background": "var(--wp--preset--color--lima-kiwi)",
              "text": "var(--wp--preset--color--grafito)"
            },
            "typography": {
              "fontFamily": "var(--wp--preset--font-family--karla)",
              "fontWeight": "700",
              "fontSize": "var(--wp--preset--font-size--13)"
            },
            "spacing": {
              "padding": {
                "top": "var(--wp--preset--spacing--30)",
                "bottom": "var(--wp--preset--spacing--30)",
                "left": "var(--wp--preset--spacing--30)",
                "right": "var(--wp--preset--spacing--30)"
              }
            }
          }
        }
      },
      "core/search": {
        "border": {
          "color": "var(--wp--preset--color--bruma)",
          "style": "solid",
          "width": "var(--wp--custom--borde--fino)",
          "radius": "var(--wp--preset--border-radius--base)"
        },
        "color": {
          "background": "var(--wp--preset--color--crema-alta)",
          "text": "var(--wp--preset--color--grafito)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--karla)",
          "fontSize": "var(--wp--preset--font-size--14)"
        }
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontWeight": "700",
          "letterSpacing": "-0.03em"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--verde-kiwi)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--guayaba)" } }
      },
      "button": {
        "border": { "radius": "2px" },
        "color": {
          "background": "var(--wp--preset--color--verde-kiwi)",
          "text": "var(--wp--preset--color--crema)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontWeight": "700",
          "fontSize": "17px"
        },
        "spacing": {
          "padding": { "top": "var(--wp--preset--spacing--40)", "bottom": "var(--wp--preset--spacing--40)", "left": "var(--wp--preset--spacing--60)", "right": "var(--wp--preset--spacing--60)" }
        }
      }
    }
  }
}
